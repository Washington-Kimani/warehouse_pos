@model IReadOnlyList<WarehouseProcurement.Controllers.InventoryRowViewModel>
@{
    ViewData["Title"] = "Inventory";
    var movements = (List<WarehouseProcurement.Models.StockMovement>)ViewBag.Movements;
}
<section class="page-heading">
    <div><div class="eyebrow">WAREHOUSE</div><h1>Inventory</h1><p>On-hand balances are calculated from the posted stock movement ledger.</p></div>
    <a class="btn btn-primary" asp-action="NewPurchaseOrder">＋ Purchase stock</a>
</section>
<section class="panel">
    @if (Model.Count == 0)
    {
        <div class="empty-state"><strong>No stock on hand</strong><span>Post a goods receipt against a purchase order to increase inventory.</span><a asp-action="NewPurchaseOrder">Create a purchase order</a></div>
    }
    else
    {
        <div class="table-responsive"><table class="table app-table">
            <thead><tr><th>Product</th><th>SKU</th><th>Warehouse</th><th>On hand</th><th>Reorder level</th><th>Last movement</th></tr></thead>
            <tbody>@foreach (var row in Model)
            {
                <tr><td><strong>@row.Product.Name</strong></td><td><span class="code-label">@row.Product.SKU</span></td><td>@row.Warehouse.Name</td><td><strong>@row.OnHand.ToString("N2")</strong> @row.Product.StockUnit</td><td>@row.Product.ReorderLevel.ToString("N2") @row.Product.StockUnit</td><td>@(row.LastMovementUtc?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "—")</td></tr>
            }</tbody>
        </table></div>
    }
</section>
<section class="panel movement-panel">
    <div class="panel-heading"><div><h2>Recent stock movements</h2><p>Latest 30 ledger entries</p></div></div>
    @if (movements.Count == 0)
    {
        <div class="empty-state compact"><span>Goods receipt postings will appear here.</span></div>
    }
    else
    {
        <div class="table-responsive"><table class="table app-table">
            <thead><tr><th>Date</th><th>Product</th><th>Warehouse</th><th>Movement</th><th>Quantity</th><th>Reference</th></tr></thead>
            <tbody>@foreach (var movement in movements)
            {
                <tr><td>@movement.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@movement.Product.Name</td><td>@movement.Warehouse.Name</td><td><span class="status-pill status-received">@movement.Type</span></td><td class="quantity-positive">+@movement.Quantity.ToString("N2") @movement.Product.StockUnit</td><td><span class="code-label">@movement.Reference</span></td></tr>
            }</tbody>
        </table></div>
    }
</section>
